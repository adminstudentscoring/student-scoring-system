# Server Configuration
PORT=3001
NODE_ENV=development

# Platform SaaS billing gate (trial / subscription). Use 0 to disable org & teacher subscription checks and PayPal subscription APIs (course Sales / orders unchanged).
# BILLING_ENFORCEMENT=1

# Data Storage Paths (relative to project root)
DATA_DIR=data
DATA_FILE=data/students.txt
SAVES_DIR=data/saves
GAME_SAVES_DIR=data/game-saves
RUNNING_QUEEN_LEADERBOARD_FILE=data/running-queen-leaderboard.txt
ROYAL_EXCHANGE_LEADERBOARD_FILE=data/royal-exchange-leaderboard.txt

# CORS Configuration (comma-separated origins, or * for all)
CORS_ORIGIN=*

# JWT Secret (for authentication - generate a random string)
# You can generate a random string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRES_IN=7d

# Users Data File
USERS_FILE=data/users.txt

# Organizations Data File
ORGANIZATIONS_FILE=data/organizations.txt

# =========================
# Postgres (Railway)
# =========================
# For Railway runtime (recommended): set DATABASE_URL (internal).
# For local development connecting to Railway: use DATABASE_PUBLIC_URL.
#
# You can also provide PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE (optional).
DATABASE_URL=
DATABASE_PUBLIC_URL=
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# Set PGSSLMODE=disable only if you know SSL is not required (Railway internal usually doesn't need SSL).
# PGSSLMODE=

# Optional: run Postgres migrations automatically at server startup (NOT recommended until you are ready).
DB_AUTO_MIGRATE=0

# Blunders: use Postgres for Teacher All blunders queries (feature flag; default off)
BLUNDERS_USE_DB=0

# =========================
# Tactics Fighter
# =========================
# Optional: store attempts as JSONL (file-based analytics/debug). Builder/puzzles are stored in Postgres.
TACTICS_FIGHTER_ATTEMPTS_FILE=data/tactics-fighter-attempts.jsonl

# =========================
# AI Coach Comments (OpenAI)
# =========================
# Low-cost recommendation: use a small/mini model and cache results for 24h per student.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible proxy base URL.
# IMPORTANT: OpenAI official base URL must include "/v1".
# - Correct: https://api.openai.com/v1
# - Wrong:   https://api.openai.com   (will cause 404)
OPENAI_BASE_URL=https://api.openai.com/v1

