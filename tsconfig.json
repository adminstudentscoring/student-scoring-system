{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@student-scoring/core": ["packages/core/src/index.ts"],
      "@student-scoring/core/*": ["packages/core/src/*"],
      "@student-scoring/application-chess": ["packages/application/chess/src/index.ts"],
      "@student-scoring/application-monster-fight": ["packages/application/monster-fight/src/index.ts"],
      "@student-scoring/application-blunders": ["packages/application/blunders/src/index.ts"],
      "@student-scoring/application-tactics-fighter": ["packages/application/tactics-fighter/src/index.ts"],
      "@student-scoring/application-truceboard": ["packages/application/truceboard/src/index.ts"],
      "@student-scoring/application-running-queen": ["packages/application/running-queen/src/index.ts"],
      "@student-scoring/application-royal-exchange": ["packages/application/royal-exchange/src/index.ts"],
      "@student-scoring/application-hope-mate": ["packages/application/hope-mate/src/index.ts"],
      "@student-scoring/vcp": ["packages/vcp/src/index.ts"],
      "@student-scoring/billing": ["packages/billing/src/index.ts"],
      "@student-scoring/billing/*": ["packages/billing/*"],
      "@student-scoring/class-view": ["packages/class-view/src/index.ts"],
      "@student-scoring/platform": ["packages/platform/src/index.ts"],
      "@config/*": ["packages/core/src/config/*"],
      "@lib/*": ["packages/core/src/lib/*"],
      "@storage/*": ["packages/core/src/storage/*"]
    }
  },
  "include": [
    "server.ts",
    "packages/core/src/**/*.ts",
    "packages/application/*/src/**/*.ts",
    "packages/vcp/src/**/*.ts",
    "packages/billing/src/**/*.ts",
    "packages/class-view/src/**/*.ts",
    "packages/platform/src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "application",
    "data"
  ]
}
