{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@config/*": ["server/config/*"],
      "@lib/*": ["server/lib/*"],
      "@storage/*": ["server/storage/*"],
      "@routes/*": ["server/routes/*"],
      "@services/*": ["server/services/*"]
    }
  },
  "include": [
    "server.ts",
    "auth.ts",
    "server/**/*.ts",
    "billing/**/*.ts",
    "db/**/*.ts",
    "middleware/**/*.ts",
    "ai/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "game",
    "data"
  ]
}
