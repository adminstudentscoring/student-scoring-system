{
  "name": "student-scoring-system",
  "version": "1.0.0",
  "private": true,
  "description": "Student scoring system for Zoom classes with gamification features",
  "main": "main.js",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "start:js": "node server.js",
    "build": "tsc --noEmit",
    "build:monster-fight": "esbuild application/monster-fight/src/main.js --bundle --format=iife --outfile=application/monster-fight/monster-fight.js",
    "build:monster-fight-shell": "esbuild application/monster-fight-shell/src/main.js --bundle --format=iife --outfile=application/monster-fight-shell.js",
    "build:tactics-fighter": "esbuild application/tactics-fighter/src/main.js --bundle --format=iife --outfile=application/tactics-fighter/tactics-fighter.js",
    "build:tactics-fighter-core": "esbuild application/tactics-fighter/src/core-main.js --bundle --format=iife --outfile=application/tactics-fighter/core.js",
    "build:blunders": "esbuild application/blunders/src/main.js --bundle --format=iife --outfile=application/blunders/blunders.js",
    "build:blunders-core": "esbuild application/blunders/src/core-main.js --bundle --format=iife --outfile=application/blunders/core.js",
    "build:blunders-teacher": "esbuild application/blunders/src/teacher-main.js --bundle --format=iife --outfile=application/blunders/teacher.js",
    "build:blunders-student": "esbuild application/blunders/src/student-main.js --bundle --format=iife --outfile=application/blunders/student.js",
    "build:chess-light": "esbuild application/chess-light/src/main.js --bundle --format=iife --outfile=application/chess-light/chess-light.js",
    "build:chess-solitaire": "esbuild application/chess-solitaire/src/main.js --bundle --format=iife --outfile=application/chess-solitaire/chess-solitaire.js",
    "build:chess-works": "esbuild application/chess-works/src/main.js --bundle --format=iife --outfile=application/chess-works/chess-works.js",
    "build:hope-mate": "esbuild application/hope-mate/src/main.js --bundle --format=iife --outfile=application/hope-mate/hope-mate.js",
    "build:maze-runner": "esbuild application/maze-runner/src/main.js --bundle --format=iife --outfile=application/maze-runner/maze-runner.js",
    "build:royal-exchange": "esbuild application/royal-exchange/src/main.js --bundle --format=iife --outfile=application/royal-exchange/royal-exchange.js",
    "build:running-queen": "esbuild application/running-queen/src/main.js --bundle --format=iife --outfile=application/running-queen/running-queen.js",
    "build:truceboard": "esbuild application/truceboard/src/main.js --bundle --format=iife --outfile=application/truceboard/truceboard.js",
    "build:vchess-platform": "esbuild application/vchess-platform/src/main.js --bundle --format=iife --outfile=application/vchess-platform/vchess-platform.js",
    "build:vchess-normal-chess": "esbuild application/vchess-platform/src/normal-chess-main.js --bundle --format=iife --outfile=application/vchess-platform/normal-chess.js",
    "build:eatwhat": "esbuild application/my-own-app/src/eatwhat-main.js --bundle --format=iife --outfile=application/my-own-app/eatwhat.js",
    "build:applications": "pnpm run build:monster-fight && pnpm run build:monster-fight-shell && pnpm run build:tactics-fighter && pnpm run build:tactics-fighter-core && pnpm run build:blunders && pnpm run build:blunders-core && pnpm run build:blunders-teacher && pnpm run build:blunders-student && pnpm run build:chess-light && pnpm run build:chess-solitaire && pnpm run build:chess-works && pnpm run build:hope-mate && pnpm run build:maze-runner && pnpm run build:royal-exchange && pnpm run build:running-queen && pnpm run build:truceboard && pnpm run build:vchess-platform && pnpm run build:vchess-normal-chess && pnpm run build:eatwhat",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "electron-dev": "electron . --dev",
    "app": "electron .",
    "init-admin": "tsx scripts/init-admin.ts",
    "migrate-students": "tsx scripts/migrate-students.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:ping": "tsx -e \"require('dotenv').config(); require('@student-scoring/core').dbPing().then(()=>console.log('OK')).catch((e)=>{console.error(e); process.exit(1);});\"",
    "blunders:import-db": "tsx scripts/blunders-import-to-db.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:lesson-quota": "node --import tsx --test test/lesson-quota-api.test.ts",
    "test:timetable": "node --import tsx --test test/timetable-api-smoke.test.ts",
    "test:orders": "node --import tsx --test test/orders-api-smoke.test.ts",
    "test:students": "node --import tsx --test test/students-api-smoke.test.ts",
    "test:settings-holiday": "node --import tsx --test test/settings-holiday-smoke.test.ts",
    "test:static-scripts": "node --import tsx --test test/static-scripts-smoke.test.ts",
    "test:application-static": "node --import tsx --test test/application-static-smoke.test.ts",
    "test:blunders": "node --import tsx --test test/blunders-public-smoke.test.ts",
    "test:blunders-teacher": "node --import tsx --test test/blunders-teacher-smoke.test.ts",
    "test:chess-works": "node --import tsx --test test/chess-works-public-smoke.test.ts",
    "test:monster-fight": "node --import tsx --test test/monster-fight-api-smoke.test.ts",
    "test:vcp": "node --import tsx --test test/vcp-health-smoke.test.ts",
    "invoice-parse-smoke": "node --import tsx --test test/invoice-pdf-parse-smoke.test.ts",
    "invoice-pdf-smoke": "tsx scripts/invoice-pdf-convert-smoke.ts",
    "vchess-llm-smoke": "tsx scripts/vchess-invoice-llm-smoke.ts",
    "test:vchess-apply": "node --import tsx --test test/vchess-import-apply-engine.test.ts",
    "test:vchess-xlsx-smoke": "node --import tsx --test test/vchess-sales-xlsx-download-smoke.test.ts",
    "test:tactics-fighter-tree": "node --import tsx --test test/tactics-fighter-teacher-tree-puzzlecount-smoke.test.ts",
    "invoice-pdf-to-xlsx": "tsx scripts/vchess-invoice-pdf-to-xlsx.ts",
    "invoice-pdf-to-sales-xlsx": "tsx scripts/invoice-pdf-to-sales-export-xlsx.ts",
    "invoice-sales-xlsx-smoke": "node --import tsx --test test/invoice-sales-xlsx-smoke.test.ts"
  },
  "keywords": [
    "student",
    "scoring",
    "zoom",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@student-scoring/application-blunders": "workspace:*",
    "@student-scoring/application-chess": "workspace:*",
    "@student-scoring/application-hope-mate": "workspace:*",
    "@student-scoring/application-monster-fight": "workspace:*",
    "@student-scoring/application-royal-exchange": "workspace:*",
    "@student-scoring/application-running-queen": "workspace:*",
    "@student-scoring/application-tactics-fighter": "workspace:*",
    "@student-scoring/application-truceboard": "workspace:*",
    "@student-scoring/billing": "workspace:*",
    "@student-scoring/class-view": "workspace:*",
    "@student-scoring/core": "workspace:*",
    "@student-scoring/platform": "workspace:*",
    "@student-scoring/vcp": "workspace:*",
    "bcrypt": "^5.1.1",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.80.0",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "stockfish": "^17.1.0",
    "ws": "^8.14.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "sharp",
      "esbuild",
      "electron"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "electron": "^27.0.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "pdf-parse": "^2.4.5",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "xlsx": "^0.18.5"
  }
}
