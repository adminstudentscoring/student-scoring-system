{
  "name": "student-scoring-system",
  "version": "1.0.0",
  "description": "Student scoring system for Zoom classes with gamification features",
  "main": "main.js",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "start:js": "node server.js",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "electron-dev": "electron . --dev",
    "app": "electron .",
    "init-admin": "node scripts/init-admin.js",
    "migrate-students": "node scripts/migrate-students.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:ping": "node -e \"require('dotenv').config(); require('./db/postgres').dbPing().then(()=>console.log('OK')).catch((e)=>{console.error(e); process.exit(1);});\"",
    "blunders:import-db": "node scripts/blunders-import-to-db.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "student",
    "scoring",
    "zoom",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.80.0",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "stockfish": "^17.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@types/ws": "^8.18.1",
    "electron": "^27.0.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
